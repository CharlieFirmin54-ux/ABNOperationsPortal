# Yahoo Mail IMAP (Emails page)
# Use a Yahoo app password, not the account password.
# See README.md for how to create one.

YAHOO_EMAIL=you@yahoo.com
YAHOO_APP_PASSWORD=

# Optional. Defaults shown.
# YAHOO_IMAP_HOST=imap.mail.yahoo.com
# YAHOO_IMAP_PORT=993

# Optional team login override. Defaults: username ABN2026 / password BeckRowABN!
# AUTH_USERNAME=ABN2026
# AUTH_PASSWORD=BeckRowABN!

# Optional. Signs the session cookie. The app can fall back.
# AUTH_SECRET=
