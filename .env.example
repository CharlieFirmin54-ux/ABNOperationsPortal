# Yahoo Mail IMAP (Emails page)
# Use a Yahoo app password, not the account password.
# See README.md for how to create one.

YAHOO_EMAIL=you@yahoo.com
YAHOO_APP_PASSWORD=

# Optional. Defaults shown.
# YAHOO_IMAP_HOST=imap.mail.yahoo.com
# YAHOO_IMAP_PORT=993

# Operator logins (never commit real passwords)
# AUTH_SECRET must be a long random string (openssl rand -hex 32).
AUTH_SECRET=

# Seeds Charlie as Administrator when AUTH_SEED_PASSWORD is set.
AUTH_SEED_NAME=Charlie
AUTH_SEED_EMAIL=charlie@abnmaintenance.co.uk
AUTH_SEED_ROLE=Administrator
AUTH_SEED_PASSWORD=

# Optional extra operators for production (Vercel). JSON array, not committed.
# AUTH_OPERATORS=[{"name":"Sam","email":"sam@abnmaintenance.co.uk","role":"Operator","password":"..."}]
